# Copy to tests/homelab/secrets.env (gitignored) and fill in. ./vm.sh provision installs it
# as /etc/planetexpress.env inside the test guest.
#
# Use a SEPARATE test Telegram bot and chat, never the production @casafarnsworthbot:
# the homelab will send real approval cards and can act on whatever chat it's pointed at.
TG_BOT_TOKEN=
TG_CHAT_ID=

# Same keys deploy.sh writes. LLM_PROVIDER is required: exactly "anthropic" or "openai".
# Set only the key for the provider you pick; a low-limit key is fine for rehearsals.
# Skip this file entirely and deploy.sh will prompt for all of it instead.
LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
