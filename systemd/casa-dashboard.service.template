[Unit]
Description=Planet Express — Read-only Web Dashboard (Scruffy)
Documentation=https://github.com/sovereignalmida/planet-express
# Dedicated unprivileged identity, never in the docker group.
# Reads code, config and snapshots through read-only ACLs; reaches core only
# through its RPC socket using planetexpress-rpc membership.
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=300
StartLimitBurst=5

[Service]
Type=simple
User=planetexpress-web
Group=planetexpress-web
SupplementaryGroups=planetexpress-rpc
WorkingDirectory=$INSTALL_DIR

# Required Airlock credentials and optional panel credentials, separate from core's
# LLM and Telegram secrets. Provision with scripts/dashboard_operators.py init.
EnvironmentFile=/etc/planetexpress-dashboard.env
NoNewPrivileges=yes
ProtectProc=invisible
ProtectSystem=strict
PrivateTmp=yes
Environment=CASA_CONFIG=$CONFIG_FILE
Environment=CASA_STATE_DIR=$INSTALL_DIR/state
Environment=CASA_LOG_DIR=$INSTALL_DIR/logs
Environment=CASA_DASHBOARD_PORT=$DASHBOARD_PORT
Environment=PYTHONUNBUFFERED=1

ExecStart=$INSTALL_DIR/venv/bin/gunicorn --workers 2 --threads 4 --bind 0.0.0.0:$DASHBOARD_PORT --worker-tmp-dir /dev/shm --no-control-socket --access-logfile - --error-logfile - casa_scruffy:create_app()

Restart=on-failure
RestartSec=15s

StandardOutput=journal
StandardError=journal
SyslogIdentifier=casa-dashboard

[Install]
WantedBy=multi-user.target
